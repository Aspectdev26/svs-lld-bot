# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Channels (right-click channel -> Copy Channel ID, Developer Mode must be on)
# CHALLENGES_CHANNEL_ID: the "Issue a Challenge" channel — hosts the pinned Challenge button and
# the pinned Active Challenges list.
CHALLENGES_CHANNEL_ID=
# CHALLENGE_RESULTS_CHANNEL_ID: permanent log of every challenge/result announcement (issued,
# won, expired, dodge-approved, force-cancelled, etc.) — nothing here auto-deletes.
CHALLENGE_RESULTS_CHANNEL_ID=
RANKINGS_CHANNEL_ID=
LEAGUE_MANAGERS_CHANNEL_ID=
REGISTER_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=

# Role that gates dodge approve/deny actions
LEAGUE_MANAGER_ROLE_NAME=League Manager

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the service account private key. Keep the \n escape sequences literal (single line).
GOOGLE_PRIVATE_KEY=

# Match timing (milliseconds). Defaults: 72h match lifespan, warn 24h before expiry,
# dodge becomes requestable 48h after a match is created with no result.
MATCH_LIFESPAN_MS=259200000
MATCH_WARNING_LEAD_MS=86400000
DODGE_ELIGIBLE_AFTER_MS=172800000

# How often the scheduler checks for warnings/expirations (milliseconds)
SCHEDULER_INTERVAL_MS=600000

# How much extra time an approved extension request grants (milliseconds). Default: 2 days.
EXTENSION_GRANT_MS=172800000

# How long a challenger must wait to re-challenge the same defender entry after losing to them
# (milliseconds). Default: 24h.
CHALLENGE_COOLDOWN_MS=86400000

# Vacation timing (milliseconds). Defaults: 14 days on regular Vacation before it auto-escalates
# to Extended Vacation, 30 days on Extended Vacation before full removal, and a shared 3-day
# lead time before either expiry for the warning DM/League Manager notice.
VACATION_EXPIRY_MS=1209600000
EXTENDED_VACATION_EXPIRY_MS=2592000000
VACATION_WARNING_LEAD_MS=259200000

# Name of the category new per-match channels are created under
MATCH_CHANNEL_CATEGORY_NAME=Current Challenges

# Max ranks a challenger may reach up the ladder (ignoring their own other-element rows)
CHALLENGE_RANGE=3
# Tighter range required when the target is within the top-N of the ladder
TOP_TIER_SIZE=10
TOP_TIER_CHALLENGE_RANGE=2
